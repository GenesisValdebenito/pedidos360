# Copia este archivo a infra/.env y ajusta los valores.
# infra/.env NO se versiona (ya está cubierto por .gitignore).

# Host/IP que los brokers anuncian a los clientes EXTERNOS.
# - Demo local o microservicios en la misma EC2: localhost
# - Postman u otra máquina apuntando a la EC2: IP pública de la EC2
EXTERNAL_HOST=localhost

# Bootstrap servers que usan los microservicios Spring Boot.
# Con EXTERNAL_HOST=localhost y servicios en la misma máquina:
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094

# Puerto de Kafka UI en el host
KAFKA_UI_PORT=8085
