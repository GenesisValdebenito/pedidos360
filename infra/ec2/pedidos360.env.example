# Variables de entorno para los microservicios en EC2.
# Copia este archivo fuera del repositorio y completa los valores reales:
#   mkdir -p /home/ec2-user/pedidos360-config
#   cp infra/ec2/pedidos360.env.example /home/ec2-user/pedidos360-config/pedidos360.env
#   chmod 600 /home/ec2-user/pedidos360-config/pedidos360.env
#
# Nunca subas el archivo completado a Git.

# Microsoft Entra ID
AZURE_TENANT_ISSUER_URI=https://login.microsoftonline.com/TU_TENANT_ID/v2.0
AZURE_API_CLIENT_ID=TU_CLIENT_ID_API

# PostgreSQL (Supabase u otro proveedor)
DB_HOST=TU_HOST
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=TU_USUARIO
DB_PASSWORD=TU_PASSWORD

# Secreto compartido solo entre orders-service y catalog-service.
# Genera un valor largo y aleatorio; no reutilices el de desarrollo.
PEDIDOS360_INTERNAL_TOKEN=TU_TOKEN_INTERNO_LARGO

# catalog-service corre en la misma EC2 que orders-service.
PEDIDOS360_CATALOG_URL=http://localhost:8082

# RabbitMQ (contenedor en la misma EC2).
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=TU_USUARIO_RABBITMQ
RABBITMQ_PASSWORD=TU_PASSWORD_RABBITMQ

# Kafka: los tres brokers del compose de infra/ en la misma EC2.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094
